binds {

    // ────────────── SYSTEM & UTILITIES ──────────────
    
    // Windows Style: Win+L to Lock
    Mod+L hotkey-overlay-title="Lock Screen" { spawn-sh "qs -c noctalia-shell ipc call lockScreen lock"; }
    
    // Windows Style: Win+X for Session/Power Menu
    Mod+X hotkey-overlay-title="Session Menu" { spawn-sh "qs -c noctalia-shell ipc call sessionMenu toggle"; }
    Mod+Shift+Q { spawn-sh "qs -c noctalia-shell ipc call sessionMenu toggle"; }
    
    // Windows Style: Win+P for Displays
    Mod+P hotkey-overlay-title="Displays" { spawn "wdisplays"; }
    XF86Display allow-when-locked=true { spawn "wdisplays"; }
    
    // Windows Style: Win+Shift+S for Snipping (Area Screenshot)
    Mod+Shift+S hotkey-overlay-title="Screenshot (Area)" { screenshot; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    CTRL+Shift+1 { screenshot; }
    CTRL+Shift+2 { screenshot-screen; }
    CTRL+Shift+3 { screenshot-window; }
    
    // Windows Style: Task Manager (Ctrl+Shift+Esc)
    Ctrl+Shift+Escape hotkey-overlay-title="Task Manager (btop)" { spawn "alacritty" "-e" "btop"; }
    
    // Niri Specific Utilities
    Mod+Alt+O hotkey-overlay-title="Toggle Window Opacity" { toggle-window-rule-opacity; }
    Mod+Shift+W hotkey-overlay-title="Reload Waybar" { spawn "pkill" "-USR2" "waybar"; }
    Mod+Shift+P hotkey-overlay-title="Power Off Monitors" { power-off-monitors; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+ESCAPE { show-hotkey-overlay; }
    Mod+F1 { show-hotkey-overlay; }
    Mod+ESCAPE allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    
    // Emergency Exit
    CTRL+ALT+Delete { quit; }

    // ────────────── APPLICATIONS ──────────────
    
    // Windows Style: Win+E for Explorer
    Mod+E hotkey-overlay-title="File Explorer (Nautilus)" { spawn "nautilus"; }
    Mod+Shift+E { spawn "nautilus"; }
    
    // Windows Style: Win+Return or Ctrl+Alt+T for Terminal
    Mod+Return hotkey-overlay-title="Terminal (Alacritty)" { spawn "alacritty"; }
    Ctrl+Alt+T hotkey-overlay-title="Terminal (Alacritty)" { spawn "alacritty"; }
    
    // Windows Style: Win+V for Clipboard
    Mod+V hotkey-overlay-title="Clipboard History (Fuzzel)" { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }
    
    // Windows Style: Win+Period for Emoji
    Mod+Period hotkey-overlay-title="Emoji Picker" { spawn "smile"; }
    
    // Windows Style: Win+R or Win+Space for Launcher
    Mod+R hotkey-overlay-title="Launcher" { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+Space hotkey-overlay-title="Launcher" { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    ALT+Space { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    
    // Web Browser
    Mod+B hotkey-overlay-title="Web Browser (Brave)" { spawn "brave"; }

    // ────────────── WINDOW MANAGEMENT ──────────────
    
    // Windows Style: Win+D to Clear Desktop (Overview)
    Mod+D repeat=false hotkey-overlay-title="Toggle Overview" { toggle-overview; }
    
    // Windows Style: Win+Up to Maximize
    Mod+Up hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+F { maximize-column; }
    Mod+M { maximize-window-to-edges; }
    Mod+Shift+F { fullscreen-window; }
    F11 { fullscreen-window; }
    
    // Windows Style: Win+Down to Focus Down
    Mod+Down hotkey-overlay-title="Focus Down" { focus-window-down; }

    // Windows Style: Win+Left/Right for Snapping (Focus Column)
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    
    // Moving Columns (Alt+Shift+Arrows instead of Win+Ctrl to avoid Workspace conflict)
    Mod+Alt+Left { move-column-left; }
    Mod+Alt+Right { move-column-right; }
    Mod+Alt+Up { move-window-up; }
    Mod+Alt+Down { move-window-down; }
    Mod+Alt+Home { move-column-to-first; }
    Mod+Alt+End { move-column-to-last; }
    CTRL+ALT+Left { move-column-left; }
    CTRL+ALT+Right { move-column-right; }
    
    // Monitor Navigation (Win+Shift+Arrows)
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+Down { focus-monitor-down; }
    
    // Move to Monitor (Win+Ctrl+Shift+Arrows)
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    
    // Windows Style: Alt+Tab Task Switching
    ALT+TAB { focus-column-right; }
    ALT+Shift+TAB { focus-column-left; }
    Mod+TAB { focus-workspace-previous; }
    
    // Closing Windows
    Mod+Q { close-window; }
    ALT+F4 { close-window; }
    
    // Vim-style Navigation (Restored where possible)
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    // Mod+L is Lock!
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }

    // ────────────── WORKSPACE NAVIGATION ──────────────
    
    // Windows Style: Win+Ctrl+Left/Right to switch virtual desktops
    Mod+Ctrl+Left { focus-workspace-up; }
    Mod+Ctrl+Right { focus-workspace-down; }
    
    // Workspace Extras
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    
    // Mouse Scroll (Win+Scroll)
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    
    // Moving Windows to Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+Shift+I { move-workspace-up; }

    // ────────────── MEDIA & HARDWARE ──────────────
    
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume increase"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume decrease"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume muteOutput"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume muteInput"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media previous"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media playPause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media playPause"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call brightness increase"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call brightness decrease"; }

    // ────────────── LAYOUT & RESIZING ──────────────
    
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    
    Mod+T { toggle-window-floating; }
    Mod+W { toggle-column-tabbed-display; }
    
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma { consume-window-into-column; }
    
    Mod+Shift+R { switch-preset-column-width; }
    Mod+Alt+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    
    // Sticky Floating Windows (Moved to Shift+Y to avoid Screenshot conflict)
    Mod+Shift+Y { spawn "niri-float-sticky" "-ipc" "toggle_sticky"; }
}
